# Copy to .env. Never commit .env.
VIGIL_ENV=dev                    # dev | test (prod is not supported in the MVP)
VIGIL_DEV_LOGIN_ENABLED=false    # may only be true when VIGIL_ENV=dev; the backend refuses to start otherwise
VIGIL_VLM_WORKER_URL=            # e.g. http://host.docker.internal:8080 (see docs/hardware-options.md)
VIGIL_ACTIVE_MODULES=oncology    # Specialty Modules shown in the frontend until per-Practice activation lands
