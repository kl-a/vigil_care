# Copy to .env (scripts/run-local.sh does this for you). Never commit .env.
# Keep comments on their own lines: Docker Compose can read an inline comment as the value.

# dev | test (prod is not supported in the MVP)
VIGIL_ENV=dev

# May only be true when VIGIL_ENV=dev; the backend refuses to start otherwise.
VIGIL_DEV_LOGIN_ENABLED=false

# Local VLM worker, e.g. http://host.docker.internal:8080 (see docs/hardware-options.md). Empty = not configured.
VIGIL_VLM_WORKER_URL=

# Specialty Modules active in the frontend until per-Practice activation lands.
VIGIL_ACTIVE_MODULES=oncology

# Database role passwords, set by `make migrate` / the migrate service (design doc §6.2).
# The defaults are for synthetic local databases only. VIGIL_DB_ADMIN_URL is the cluster admin used to create roles.
# VIGIL_DB_ADMIN_URL=postgresql://vigil:vigil@localhost:5432/vigil
# VIGIL_DB_OWNER_PASSWORD=vigil_owner_dev
# VIGIL_DB_APP_PASSWORD=vigil_app_dev
# VIGIL_DB_SUPPORT_PASSWORD=vigil_support_dev

# Ports. scripts/run-local.sh picks the next free port if one is taken by another app.
# VIGIL_FRONTEND_PORT=3000
# VIGIL_BACKEND_PORT=8000
# VIGIL_DB_PORT=5432
# VIGIL_TEST_DB_PORT=55432
